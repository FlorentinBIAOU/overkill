# En-têtes servis par Cloudflare Pages.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  # Le site ne charge aucune ressource tierce, et n'en chargera pas.
  # La politique le rend opposable plutôt que déclaratif.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

# Les polices ne changent jamais sans changer de nom.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

---
/**
 * La racine du site (CDC 9.3).
 *
 * La négociation sur `Accept-Language` est faite par l'hébergeur, via
 * `public/_redirects`. Cette page est le repli : elle s'affiche si la
 * redirection n'a pas eu lieu, propose explicitement les deux langues, et
 * bascule vers l'anglais, version canonique, par un rafraîchissement de méta.
 *
 * Elle fonctionne donc entièrement sans JavaScript, ce qui est la condition
 * posée par la section 8.7.
 */
import Base from '../layouts/Base.astro';
import { LOCALE_NAMES, LOCALES } from '../i18n';
---

<Base title="Overkill" lang="en" noindex>
  <Fragment slot="head">
    <meta http-equiv="refresh" content="0; url=/en" />
    <link rel="alternate" hreflang="en" href="/en" />
    <link rel="alternate" hreflang="fr" href="/fr" />
    <link rel="alternate" hreflang="x-default" href="/en" />
  </Fragment>

  <div class="root">
    <p class="root__brand">Overkill</p>
    <h1 class="root__title display-l">Choose your language</h1>
    <ul class="root__list">
      {
        LOCALES.map((l) => (
          <li>
            <a href={`/${l}`} hreflang={l} lang={l}>
              {LOCALE_NAMES[l]}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .root {
    max-width: 30rem;
    margin: 0 auto;
    padding: var(--space-24) var(--space-6);
  }

  .root__brand {
    font-family: var(--font-display);
    font-weight: 800;
    margin: 0 0 var(--space-8);
  }

  .root__title {
    margin: 0 0 var(--space-8);
  }

  .root__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-6);
    font-size: var(--size-h3);
    font-weight: 600;
  }
</style>

---
import EntryLayout from '../../layouts/EntryLayout.astro';
import { DEMO_ENTRIES, DEMO_FAMILY_TITLES } from '../../../tests/fixtures/pages/entries';

const entry = DEMO_ENTRIES[0];
/* Les fiches voisines reprennent le format carte du catalogue : le gabarit
   reçoit donc les fiches entières, pas seulement leur titre. */
const neighbours = DEMO_ENTRIES.slice(1);
---

<EntryLayout
  entry={entry}
  lang="fr"
  familyTitle={DEMO_FAMILY_TITLES[entry.family]}
  neighbours={neighbours}
  familyTitles={DEMO_FAMILY_TITLES}
/>

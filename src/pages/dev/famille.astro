---
import FamilyLayout from '../../layouts/FamilyLayout.astro';
import {
  DEMO_ENTRIES, DEMO_FAMILY, DEMO_FAMILY_TITLES, ISSUE_URL,
} from '../../../tests/fixtures/pages/entries';

const entries = DEMO_ENTRIES.filter((e) => e.family === DEMO_FAMILY.id);
const planned = [
  { id: 'detect-spam-in-contact-form', title: { fr: 'Repérer le spam dans un formulaire de contact', en: 'Detect spam in a contact form' } },
  { id: 'find-duplicate-records', title: { fr: 'Repérer les doublons dans une base clients', en: 'Find duplicate records' } },
];
---

<FamilyLayout
  lang="fr"
  family={DEMO_FAMILY}
  entries={entries}
  familyTitles={DEMO_FAMILY_TITLES}
  planned={planned}
  issueUrl={ISSUE_URL}
/>

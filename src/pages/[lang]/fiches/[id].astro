---
/**
 * Une page par fiche (CDC 7.5).
 */
import EntryLayout from '../../../layouts/EntryLayout.astro';
import { publishedEntries, neighboursOf, familyTitles } from '../../../lib/content';
import { LOCALES, type Locale } from '../../../i18n';

export async function getStaticPaths() {
  const fiches = await publishedEntries();
  return LOCALES.flatMap((lang) =>
    fiches.map((entry) => ({
      params: { lang, id: entry.data.id },
      props: { entry: entry.data, neighbours: neighboursOf(entry, fiches).map((n) => n.data) },
    })),
  );
}

const lang = Astro.params.lang as Locale;
const { entry, neighbours } = Astro.props;
const titres = await familyTitles(lang);
---

<EntryLayout
  entry={entry}
  lang={lang}
  familyTitle={titres[entry.family] ?? entry.family}
  neighbours={neighbours}
  familyTitles={titres}
/>

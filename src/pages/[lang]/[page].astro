---
/**
 * Les pages éditoriales : méthodologie, à propos, contribuer, accompagnement,
 * mentions légales, confidentialité, crédits (CDC 7.6 à 7.10).
 *
 * Leur contenu vit dans `content/pages/`, un fichier par page et par langue.
 * Une page marquée brouillon le dit visiblement : l'interdit 10 refuse le faux
 * contenu, il n'interdit pas un brouillon assumé.
 */
import { getCollection, render } from 'astro:content';
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import HelpBlock from '../../components/HelpBlock.astro';
import LegalNotice from '../../components/LegalNotice.astro';
import { ERROR_URL, ISSUE_URL, REPO_URL } from '../../lib/content';
import { LOCALES, t, type Locale } from '../../i18n';
import { route, SEGMENTS, type PageKey } from '../../i18n/routes';

/** Les pages qui portent du contenu réglementaire reçoivent l'encadré permanent. */
const REGLEMENTAIRES = new Set(['methodology', 'legal', 'privacy']);

/**
 * L'aplat d'en-tête de chaque page. Toutes en ont un : une page sans aplat
 * restait en retrait de celles qui en portaient, sans que rien ne le
 * justifie. Les pages légales prennent le fond secondaire plutôt que le jaune,
 * qui appartient à ce qui vend l'idée.
 */
const APLAT: Record<string, 'brand' | 'ink' | 'paper-2'> = {
  methodology: 'brand',
  about: 'ink',
  contribute: 'brand',
  help: 'brand',
  legal: 'paper-2',
  privacy: 'paper-2',
  credits: 'paper-2',
};

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages
    // L'accueil a sa propre route : son contenu ne passe pas par ce gabarit.
    .filter((p) => p.data.page !== 'home')
    .filter((p) => (LOCALES as readonly string[]).includes(p.data.lang))
    .map((p) => ({
      params: { lang: p.data.lang, page: SEGMENTS[p.data.page as PageKey] ?? p.data.page },
      props: { page: p },
    }));
}

const lang = Astro.params.lang as Locale;
const { page } = Astro.props;
const strings = t(lang);
const { Content } = await render(page);
const cle = page.data.page;

/*
 * L'appel à l'action de fin de page, quand la page a quelque chose à proposer.
 *
 * La page contribuer en avait besoin pour une autre raison que l'apparence :
 * elle décrivait le bouton « proposer une fiche sans coder » que la section 7.8
 * du CDC demande, sans jamais le poser.
 *
 * Les pages légales n'en portent pas. Une page qui n'a rien à vendre s'arrête
 * sur son contenu ; un appel à l'action creux serait pire que rien.
 */
const c = strings.pageCta;
const CTA: Record<string, any> = {
  methodology: {
    ...c.methodology,
    href: route(lang, 'catalogue'),
  },
  contribute: {
    ...c.contribute,
    href: ISSUE_URL,
    external: true,
    secondaryHref: ERROR_URL,
  },
  credits: {
    ...c.credits,
    href: REPO_URL,
    external: true,
  },
};
const cta = CTA[cle];
---

<EditorialLayout
  title={page.data.title}
  description={page.data.description}
  lead={page.data.description}
  lang={lang}
  band={APLAT[cle] ?? 'paper-2'}
  draft={page.data.draft}
  draftReason={page.data.draft_reason}
>
  <div class="wrap-reading page">
    <Content />

    {REGLEMENTAIRES.has(cle) && <div class="page__notice"><LegalNotice strings={strings} /></div>}

    <p class="page__updated small">
      {strings.entry.updated}
      <time datetime={page.data.updated.toISOString().slice(0, 10)}>
        {new Intl.DateTimeFormat(lang, { dateStyle: 'long' }).format(page.data.updated)}
      </time>
    </p>
  </div>

  {/* L'accompagnement est le seul appel à l'action de la page à propos : c'est
      la suite naturelle de « voilà qui je suis ». */}
  {cle === 'about' && <HelpBlock strings={strings} />}

  {
    cta && (
      <CtaBand
        reading
        heading={cta.heading}
        body={cta.body}
        action={{ label: cta.action, href: cta.href, external: cta.external }}
        secondary={
          cta.secondary
            ? { label: cta.secondary, href: cta.secondaryHref, external: true }
            : undefined
        }
      />
    )
  }
</EditorialLayout>

<style>
  .page {
    padding-block-end: var(--space-16);
  }

  .page :global(h2) {
    margin-block: var(--space-16) var(--space-4);
  }

  .page :global(h3) {
    margin-block: var(--space-8) var(--space-3);
  }

  .page :global(p),
  .page :global(ul),
  .page :global(ol) {
    margin-block: var(--space-4);
  }

  .page :global(li) {
    margin-block: var(--space-2);
  }

  .page :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--size-small);
    margin-block: var(--space-6);
  }

  .page :global(th),
  .page :global(td) {
    text-align: left;
    padding: var(--space-2) var(--space-3);
    border-block-start: 1px solid var(--rule);
    vertical-align: top;
  }

  .page :global(thead th) {
    border-block-start: 0;
    border-block-end: 1px solid var(--rule-strong);
    color: var(--muted);
  }

  .page :global(code) {
    background: var(--paper-2);
    padding: 0 var(--space-1);
    border-radius: var(--radius-block);
  }

  /* Le même fond sombre que les blocs de code des fiches : il n'y a qu'un
     traitement du code sur le site. */
  .page :global(pre) {
    background: var(--code-surface);
    color: var(--code-on-surface);
    border-radius: var(--radius-block);
    padding: var(--space-4) var(--space-6);
    margin-block: var(--space-6);
    overflow-x: auto;
  }

  .page :global(pre code) {
    background: none;
    padding: 0;
  }

  /* Ce qui reste à compléter le dit, plutôt que d'être inventé (interdit 10). */
  .page :global(.a-completer) {
    border: 2px dashed var(--rule-strong);
    border-radius: var(--radius-block);
    padding: var(--space-4) var(--space-6);
    margin-block: var(--space-6);
    background: var(--paper-2);
  }

  .page__notice {
    margin-block-start: var(--space-16);
  }

  .page__updated {
    margin-block-start: var(--space-8);
    color: var(--muted);
  }
</style>

---
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  lang?: 'en' | 'fr';
  /** Registre visuel de la page (CDC 8.1). */
  register?: 'editorial' | 'documentary';
  noindex?: boolean;
  /**
   * L'image de partage, servie depuis ce domaine. Les fiches ont la leur,
   * produite à la construction du site par scripts/build-og-images.mjs ; les
   * autres pages emploient celle du site.
   */
  image?: string;
}

const {
  title,
  description = '',
  lang = 'en',
  register = 'editorial',
  noindex = false,
  image = '/og.png',
} = Astro.props;
---

<!doctype html>
<html lang={lang} data-register={register}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}

    <slot name="head" />

    <!-- Polices auto-hébergées. Aucune ressource tierce (CDC 12). -->
    <link
      rel="preload"
      href="/fonts/bricolage-grotesque-display.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Le thème suit le système par défaut. Le choix explicite de
         l'utilisateur est applique par le script du sélecteur, sans écriture
         préalable en stockage local (CDC 9.3). -->
    <script is:inline>
      try {
        const t = localStorage.getItem('overkill-theme');
        if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
      } catch {}
    </script>

    <!-- Partage social. L'image est servie depuis le site, aucune ressource tierce. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Overkill" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta property="og:image" content={new URL(image, Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="google-site-verification" content="Tfl7t8WHIpn3A3jS923dJP2riNpKiDIZRfSnIgDBO6Y" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!--
      La seule mesure d'audience du site, et la seule exception à l'interdit 6
      du cahier des charges.

      Elle est servie **depuis ce domaine** : le chemin `/_vercel/insights/` est
      rendu par l'hébergeur, pas par un tiers. Aucun cookie n'est déposé, aucun
      identifiant individuel n'est écrit, et rien ne relie deux visites. Ce
      qu'elle compte : des pages vues et des provenances, agrégées.

      Ce n'est donc pas un traceur, et ce n'est pas non plus rien : la page
      confidentialité le dit en clair plutôt que de le passer sous silence.
      En développement, le chemin n'existe pas et la requête échoue sans
      conséquence.
    -->
    <script defer src="/_vercel/insights/script.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {lang === 'fr' ? 'Aller au contenu' : 'Skip to content'}
    </a>

    <slot name="header" />

    <main id="main">
      <slot />
    </main>

    <slot name="footer" />
  </body>
</html>

---
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  lang?: 'en' | 'fr';
  /** Registre visuel de la page (CDC 8.1). */
  register?: 'editorial' | 'documentary';
  noindex?: boolean;
}

const {
  title,
  description = '',
  lang = 'en',
  register = 'editorial',
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang={lang} data-register={register}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}

    <!-- Polices auto-hebergees. Aucune ressource tierce (CDC 12). -->
    <link
      rel="preload"
      href="/fonts/bricolage-grotesque-display.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Le theme suit le systeme par defaut. Le choix explicite de
         l'utilisateur est applique par le script du selecteur, sans ecriture
         prealable en stockage local (CDC 9.3). -->
    <script is:inline>
      try {
        const t = localStorage.getItem('overkill-theme');
        if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {lang === 'fr' ? 'Aller au contenu' : 'Skip to content'}
    </a>

    <slot name="header" />

    <main id="main">
      <slot />
    </main>

    <slot name="footer" />
  </body>
</html>

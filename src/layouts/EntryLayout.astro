---
/**
 * Gabarit de fiche. Registre documentaire (CDC 7.5) : peu de direction
 * artistique, beaucoup de contenu, le code visible immédiatement.
 *
 * L'ordre de lecture est celui de quelqu'un qui arrive avec une question :
 * la réponse en toutes lettres dans le bandeau, pourquoi juste après, le code
 * du niveau recommandé, l'essai qui le fait tourner, ce que ça implique, ce
 * qui le fait céder. Les trois autres niveaux viennent ensuite, repliés : ils
 * n'intéressent que celui qui doute du verdict.
 *
 * Le verdict apparaît deux fois, en réponse dans le bandeau et sur la carte du
 * niveau recommandé, pour que quelqu'un qui ne lit rien reparte quand même
 * avec la réponse (CDC 4.3).
 */
import SiteLayout from './SiteLayout.astro';
import Callout from '../components/Callout.astro';
import EntryCard from '../components/EntryCard.astro';
import HelpBlock from '../components/HelpBlock.astro';
import LegalNotice from '../components/LegalNotice.astro';
import LinkList from '../components/LinkList.astro';
import RungSection from '../components/RungSection.astro';
import ShareBlock from '../components/ShareBlock.astro';
import TocSticky from '../components/TocSticky.astro';
import { tryoutFor } from '../lib/tryouts.mjs';
import { t, type Locale } from '../i18n';
import { route } from '../i18n/routes';

export interface Props {
  entry: any;
  lang: Locale;
  familyTitle: string;
  /** Deux ou trois fiches de la même famille, calculées au build. */
  neighbours: any[];
  /** Titres de famille, pour les cartes des fiches voisines. */
  familyTitles: Record<string, string>;
  /**
   * Le badge de README de la fiche. Produit à la construction du site pour
   * chaque fiche publiée ; les pages de démonstration du gabarit en désignent
   * un qui existe, puisque leurs fiches factices n'en ont pas.
   */
  badge?: string;
}

const { entry, lang, familyTitle, neighbours, familyTitles, badge } = Astro.props;
const strings = t(lang);

/** Le niveau recommandé : c'est lui qui porte les faits du bandeau. */
const vr = entry.rungs.find((r: any) => r.level === entry.verdict);

const dateFormat = new Intl.DateTimeFormat(lang, { dateStyle: 'long' });
const updated = entry.updated instanceof Date ? entry.updated : new Date(entry.updated);

/* L'essai de la fiche, s'il en a un, et le niveau vers lequel renvoie un cas
   qui échoue : le suivant qui soit documenté, pas le suivant en numéro. */
const tryout = tryoutFor(entry.id);
const verdictRank = Number(String(entry.verdict).slice(1));
const above = entry.rungs.find(
  (r: any) => r.available && Number(String(r.level).slice(1)) > verdictRank,
);
const nextLevel = above
  ? { href: `#${String(above.level).toLowerCase()}`, label: above.name[lang] }
  : undefined;

/* L'adresse absolue de la fiche : ce qu'on partage, et ce que le Markdown du
   badge doit porter pour être collable tel quel. */
const site = (Astro.site ?? new URL('https://isitoverkill.dev')).origin;
const url = `${site}${route(lang, 'entries', entry.id)}`;

const toc = [
  { href: '#verdict', label: strings.verdict.heading },
  { href: `#${String(entry.verdict).toLowerCase()}`, label: `${entry.verdict} — ${vr.name[lang]}` },
  ...(tryout ? [{ href: '#essai', label: strings.tryout.heading }] : []),
  { href: '#options', label: strings.entry.fourOptions },
  ...entry.rungs
    .filter((r: any) => r.level !== entry.verdict)
    .map((r: any) => ({
      href: `#${r.level.toLowerCase()}`,
      label: r.available
        ? `${r.level} — ${r.name[lang]}`
        : `${r.level} — ${strings.rung.unavailable}`,
      muted: !r.available,
    })),
  { href: '#sources', label: strings.entry.sources },
];

/** Le périmètre réglementaire n'est affiché que s'il dit quelque chose. */
const hasRegulatory = entry.rungs.some(
  (r: any) => r.available && r.risks.regulatory[lang].length > 0,
);
---

<SiteLayout
  title={entry.title[lang]}
  description={entry.need[lang]}
  lang={lang}
  register="documentary"
  image={`/og/${lang}/${entry.id}.png`}
>
  <article class="entry">
    <header class="band band-brand entry__head">
      <div class="wrap">
        <p class="entry__breadcrumb">
          <a href={route(lang, 'catalogue')}>{strings.catalogue.title}</a>
          <span aria-hidden="true">/</span>
          <a href={route(lang, 'families', entry.family)}>{familyTitle}</a>
        </p>

        <h1 class="entry__title display-l">{entry.title[lang]}</h1>
        <p class="entry__need">{entry.need[lang]}</p>

        <p class="entry__answer">{strings.rung.answer[entry.verdict]}</p>

        <p class="entry__facts">
          <span>{strings.plainCost[vr?.cost] ?? vr?.cost}</span>
          <span>{strings.plainLatency[vr?.latency] ?? vr?.latency}</span>
          <span>{strings.plainEgress[vr?.risks.data_egress] ?? vr?.risks.data_egress}</span>
          {entry.status === 'draft' && <span>{strings.entry.draft}</span>}
        </p>
      </div>
    </header>

    <div class="wrap entry__main">
      {
        entry.status === 'draft' && (
          <div class="entry__draft-note">
            <Callout tone="marked" title={strings.entry.draft}>
              <p>{strings.entry.draftNote}</p>
            </Callout>
          </div>
        )
      }

      <div class="doc-layout">
        <aside class="doc-aside">
          <TocSticky title={strings.entry.contents} items={toc} />
        </aside>

        <div class="entry__body">
          {/* Le raisonnement d'abord, en français : c'est ce qu'on vient
              chercher. Le code vient après, pour qui implémente. */}
          <section id="verdict" class="entry__lede">
            <h2 class="visually-hidden">{strings.verdict.heading}</h2>
            <p class="entry__lede-text">{entry.verdict_rationale[lang]}</p>
          </section>

          {/* Le niveau recommandé, seul et déplié. */}
          <RungSection
            rung={vr}
            isVerdict={true}
            lang={lang}
            strings={strings}
            tryout={tryout}
            nextLevel={nextLevel}
          />

          <section id="options" class="entry__section">
            <h2 class="entry__h2">{strings.entry.fourOptions}</h2>
            <ol class="scale">
              {
                entry.rungs.map((r: any) => (
                  <li class:list={['step', r.level === entry.verdict && 'step--on', !r.available && 'step--off']}>
                    {r.level === entry.verdict && (
                      <span class="step__tag">{strings.verdict.badge}</span>
                    )}
                    <span class="step__n">{r.level}</span>
                    <span class="step__name">
                      {r.available ? r.name[lang] : strings.rung.unavailable}
                    </span>
                    <span class="step__f">
                      {r.available
                        ? `${strings.plainCost[r.cost] ?? r.cost} · ${strings.plainLatency[r.latency] ?? r.latency}`
                        : ''}
                    </span>
                  </li>
                ))
              }
            </ol>
          </section>

          {/* Les autres niveaux, repliés : ils n'intéressent que celui qui
              doute du verdict, et ils écrasaient la page. */}
          <section class="entry__section">
            <h2 class="entry__h2">{strings.entry.otherLevels}</h2>
            <Callout title={strings.entry.scenario}>
              <p>{entry.scenario[lang]}</p>
            </Callout>
            <div class="entry__folds">
              {
                entry.rungs
                  .filter((r: any) => r.level !== entry.verdict)
                  .map((rung: any) => (
                    <details class="entry__fold">
                      <summary>
                        <span class="entry__fold-level">{rung.level}</span>
                        <span class="entry__fold-name">
                          {rung.available ? rung.name[lang] : strings.rung.unavailable}
                        </span>
                        {rung.available && (
                          <span class="entry__fold-facts">
                            {strings.plainCost[rung.cost] ?? rung.cost} · {strings.plainLatency[rung.latency] ?? rung.latency}
                          </span>
                        )}
                      </summary>
                      <RungSection rung={rung} isVerdict={false} lang={lang} strings={strings} />
                    </details>
                  ))
              }
            </div>
          </section>

          <section id="sources" class="entry__section entry__refs">
            {
              entry.further_reading.length > 0 && (
                <>
                  <h2 class="entry__h2">{strings.entry.furtherReading}</h2>
                  <LinkList links={entry.further_reading} strings={strings} />
                </>
              )
            }

            {
              entry.sources.length > 0 && (
                <>
                  <h2 class="entry__h2">{strings.entry.sources}</h2>
                  <LinkList links={entry.sources} strings={strings} />
                </>
              )
            }

            <h2 class="entry__h2">{strings.entry.metadata}</h2>
            <dl class="entry__meta">
              <div>
                <dt>{strings.entry.family}</dt>
                <dd><a href={route(lang, 'families', entry.family)}>{familyTitle}</a></dd>
              </div>
              <div>
                <dt>{strings.entry.updated}</dt>
                <dd>{dateFormat.format(updated)}</dd>
              </div>
              <div>
                <dt>{strings.entry.contributors}</dt>
                <dd>{entry.contributors.join(', ')}</dd>
              </div>
            </dl>

            {hasRegulatory && <LegalNotice strings={strings} />}
          </section>

          <div class="entry__section">
            <ShareBlock
              url={url}
              title={entry.title[lang]}
              answer={strings.rung.answer[entry.verdict]}
              badge={badge ?? `/badge/${lang}/${entry.id}.png`}
              site={site}
              strings={strings}
            />
          </div>

          {/* Les fiches voisines reprennent le format du catalogue : on
              comprend ce qu'on va ouvrir avant de cliquer. */}
          {
            neighbours.length > 0 && (
              <nav class="entry__section" aria-labelledby="neighbours-title">
                <h2 id="neighbours-title" class="entry__h2">{strings.entry.neighbours}</h2>
                <ul class="entry__neighbours">
                  {neighbours.map((n: any) => {
                    const nr = n.rungs.find((r: any) => r.level === n.verdict);
                    return (
                      <EntryCard
                        id={n.id}
                        href={route(lang, 'entries', n.id)}
                        title={n.title[lang]}
                        need={n.need[lang]}
                        familyLabel={familyTitles[n.family] ?? n.family}
                        family={n.family}
                        verdict={n.verdict}
                        available={n.rungs.filter((r: any) => r.available).map((r: any) => r.level)}
                        egress={nr?.risks.data_egress ?? 'none'}
                        deterministic={nr?.risks.deterministic ?? true}
                        cost={nr?.cost}
                        latency={nr?.latency}
                        strings={strings}
                        draft={n.status === 'draft'}
                      />
                    );
                  })}
                </ul>
              </nav>
            )
          }
        </div>
      </div>
    </div>

    <HelpBlock strings={strings} source={entry.title[lang]} />
  </article>
</SiteLayout>

<script>
  import '../scripts/code-tabs.js';
</script>

<style>
  .entry__head {
    padding-block: var(--space-12) var(--space-16);
  }

  .entry__main {
    padding-block: var(--space-16) var(--space-24);
  }

  .entry__breadcrumb {
    display: flex;
    gap: var(--space-2);
    font-size: var(--size-small);
    margin: 0 0 var(--space-4);
    max-width: none;
  }

  .entry__title {
    max-width: 20ch;
  }

  .entry__need {
    margin-block-start: var(--space-4);
    font-size: var(--size-h3);
    line-height: 1.45;
  }

  /* La réponse en toutes lettres : c'est elle qu'on emporte si on ne lit
     rien d'autre (décisions de clarté, section 3). */
  .entry__answer {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.2rem, 6vw, 4.2rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
    max-width: 17ch;
    margin-block: var(--space-8) 0;
  }

  .entry__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-start: var(--space-8);
    max-width: none;
  }

  .entry__facts span {
    font-size: 0.83rem;
    font-weight: 500;
    padding: 7px 14px;
    border: 1.5px solid var(--rule-strong);
    border-radius: var(--radius-pill);
  }

  .entry__draft-note {
    margin-block-end: var(--space-12);
  }

  .entry__h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-6);
  }

  /* Le rythme de la page : une respiration franche entre les sections, pas
     des blocs qui se touchent. */
  .entry__section {
    margin-block-start: var(--space-24);
  }

  .entry__lede-text {
    font-size: 1.22rem;
    line-height: 1.62;
    max-width: 58ch;
    margin: 0 0 var(--space-16);
  }

  /* Les quatre options, en cartes : un tableau à sept colonnes ne se lit pas
     à 360 px, et personne ne lit sept colonnes de toute façon. */
  .scale {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--space-4);
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    position: relative;
    padding: var(--space-6);
    max-width: none;
    border: 1px solid var(--rule-strong);
    border-radius: 14px;
  }

  .step--on {
    border: 2px solid var(--recommended);
    padding: calc(var(--space-6) - 1px);
  }

  /* Un niveau sans objet est marqué absent, jamais atténué : une opacité de
     0,55 faisait passer son texte sous le seuil AA, ce que l'audit a
     signalé. Le trait et le pointillé disent la même chose sans coûter la
     lisibilité. */
  .step--off {
    border-style: dashed;
  }

  .step--off .step__name {
    text-decoration: line-through;
    color: var(--muted);
  }

  .step__tag {
    position: absolute;
    inset-block-start: -10px;
    inset-inline-start: 18px;
    background: var(--recommended);
    color: var(--paper);
    font-size: 0.7rem;
    font-weight: 600;
    padding: 5px 10px;
    border-radius: var(--radius-pill);
  }

  .step__n {
    font-family: var(--font-code);
    font-size: 0.72rem;
    color: var(--muted);
  }

  .step__name {
    font-weight: 600;
    font-size: 0.97rem;
    line-height: 1.35;
  }

  .step__f {
    margin-block-start: auto;
    padding-block-start: var(--space-3);
    font-size: 0.8rem;
    color: var(--muted);
  }

  .entry__folds {
    margin-block-start: var(--space-8);
    border-block-start: 1px solid var(--rule);
  }

  .entry__fold {
    border-block-end: 1px solid var(--rule);
  }

  .entry__fold summary {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-5);
    cursor: pointer;
    list-style: none;
  }

  .entry__fold summary::-webkit-details-marker { display: none; }

  .entry__fold summary::after {
    content: '+';
    margin-inline-start: auto;
    font-family: var(--font-code);
    color: var(--muted);
  }

  .entry__fold[open] summary::after { content: '−'; }

  .entry__fold-level {
    font-family: var(--font-code);
    font-size: 0.78rem;
    color: var(--muted);
    flex: none;
  }

  .entry__fold-name {
    font-weight: 600;
  }

  .entry__fold-facts {
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* Dans un repli, la section de niveau n'a plus besoin de son filet ni de
     son retrait : le repli les porte déjà. */
  .entry__fold :global(.rung-section) {
    border-block-start: 0;
    padding-block-start: 0;
  }

  .entry__refs .entry__h2 + .entry__h2,
  .entry__refs :global(.links) + .entry__h2,
  .entry__refs .entry__meta + .entry__h2 {
    margin-block-start: var(--space-12);
  }

  .entry__meta {
    display: grid;
    gap: var(--space-3);
    font-size: var(--size-small);
    margin: 0;
  }

  .entry__meta div {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .entry__meta dt {
    color: var(--muted);
    min-width: 10rem;
  }

  .entry__meta dd {
    margin: 0;
  }

  .entry__refs :global(.legal-notice) {
    margin-block-start: var(--space-8);
  }

  .entry__neighbours {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }
</style>

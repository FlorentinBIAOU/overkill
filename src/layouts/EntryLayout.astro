---
/**
 * Gabarit de fiche. Registre documentaire (CDC 7.5) : peu de direction
 * artistique, beaucoup de contenu, le code visible immédiatement.
 *
 * Le verdict apparaît deux fois, en badge d'en-tête et dans le tableau, pour
 * que quelqu'un qui ne lit rien reparte quand même avec la réponse (CDC 4.3).
 */
import SiteLayout from './SiteLayout.astro';
import Callout from '../components/Callout.astro';
import HelpBlock from '../components/HelpBlock.astro';
import LegalNotice from '../components/LegalNotice.astro';
import RungSection from '../components/RungSection.astro';
import RungTable from '../components/RungTable.astro';
import TocSticky from '../components/TocSticky.astro';
import VerdictBadge from '../components/VerdictBadge.astro';
import { t, type Locale } from '../i18n';
import { route } from '../i18n/routes';
import type { Level } from '../content/schema/enums';

export interface Props {
  entry: any;
  lang: Locale;
  familyTitle: string;
  /** Deux ou trois fiches de la même famille, calculées au build. */
  neighbours: { href: string; title: string }[];
}

const vr = (Astro.props as any).entry?.rungs?.find((r: any) => r.level === (Astro.props as any).entry.verdict);
const { entry, lang, familyTitle, neighbours } = Astro.props;
const strings = t(lang);

const dateFormat = new Intl.DateTimeFormat(lang, { dateStyle: 'long' });
const updated = entry.updated instanceof Date ? entry.updated : new Date(entry.updated);

const toc = [
  ...entry.rungs.map((r: any) => ({
    href: `#${r.level.toLowerCase()}`,
    label: r.available
      ? `${r.level} — ${r.name[lang]}`
      : `${r.level} — ${strings.rung.unavailable}`,
    muted: !r.available,
  })),
  { href: '#verdict', label: strings.verdict.heading },
  { href: '#sources', label: strings.entry.sources },
];

/** Le périmètre réglementaire n'est affiché que s'il dit quelque chose. */
const hasRegulatory = entry.rungs.some(
  (r: any) => r.available && r.risks.regulatory[lang].length > 0,
);
---

<SiteLayout
  title={entry.title[lang]}
  description={entry.need[lang]}
  lang={lang}
  register="documentary"
>
  <article class="entry">
    <header class="band band-brand entry__head">
      <div class="wrap">
        <p class="entry__breadcrumb">
          <a href={route(lang, 'catalogue')}>{strings.catalogue.title}</a>
          <span aria-hidden="true">/</span>
          <a href={route(lang, 'families', entry.family)}>{familyTitle}</a>
        </p>

        <h1 class="entry__title display-l">{entry.title[lang]}</h1>
        <p class="entry__need">{entry.need[lang]}</p>

        <p class="entry__answer">{strings.rung.answer[entry.verdict]}</p>

        <p class="entry__facts">
          <span>{strings.plainCost[vr?.cost] ?? vr?.cost}</span>
          <span>{strings.plainLatency[vr?.latency] ?? vr?.latency}</span>
          <span>{strings.plainEgress[vr?.risks.data_egress] ?? vr?.risks.data_egress}</span>
          {entry.status === 'draft' && <span>{strings.entry.draft}</span>}
        </p>
      </div>
    </header>

    <div class="wrap">
      {
        entry.status === 'draft' && (
          <div class="entry__draft-note">
            <Callout tone="marked" title={strings.entry.draft}>
              <p>{strings.entry.draftNote}</p>
            </Callout>
          </div>
        )
      }

      <div class="doc-layout">
        <aside class="doc-aside">
          <TocSticky title={strings.entry.contents} items={toc} />
        </aside>

        <div class="entry__body">
          {/* Le raisonnement d'abord, en francais : c'est ce qu'on vient
              chercher. Le code vient apres, pour qui implemente. */}
          <section id="verdict" class="entry__why">
            <p class="entry__why-text">{entry.verdict_rationale[lang]}</p>
          </section>

          {/* Le niveau recommande, seul et deplie. */}
          {
            entry.rungs
              .filter((r: any) => r.level === entry.verdict)
              .map((rung: any) => (
                <RungSection rung={rung} isVerdict={true} lang={lang} strings={strings} />
              ))
          }

          <h2 class="entry__h2">{strings.entry.fourOptions}</h2>
          <ol class="scale">
            {
              entry.rungs.map((r: any) => (
                <li class:list={['step', r.level === entry.verdict && 'step--on', !r.available && 'step--off']}>
                  {r.level === entry.verdict && (
                    <span class="step__tag">{strings.verdict.badge}</span>
                  )}
                  <span class="step__n">{r.level}</span>
                  <span class="step__name">
                    {r.available ? r.name[lang] : strings.rung.unavailable}
                  </span>
                  <span class="step__f">
                    {r.available
                      ? `${strings.plainCost[r.cost] ?? r.cost} · ${strings.plainLatency[r.latency] ?? r.latency}`
                      : ''}
                  </span>
                </li>
              ))
            }
          </ol>

          {/* Les autres niveaux, replies : ils n'interessent que celui qui
              doute du verdict, et ils ecrasaient la page. */}
          <section class="entry__others">
            <h2 class="entry__h2">{strings.entry.otherLevels}</h2>
            <Callout title={strings.entry.scenario}>
              <p>{entry.scenario[lang]}</p>
            </Callout>
            {
              entry.rungs
                .filter((r: any) => r.level !== entry.verdict)
                .map((rung: any) => (
                  <details class="entry__fold">
                    <summary>
                      <span class="entry__fold-level">{rung.level}</span>
                      <span class="entry__fold-name">
                        {rung.available ? rung.name[lang] : strings.rung.unavailable}
                      </span>
                      {rung.available && (
                        <span class="entry__fold-facts">
                          {strings.plainCost[rung.cost] ?? rung.cost} · {strings.plainLatency[rung.latency] ?? rung.latency}
                        </span>
                      )}
                    </summary>
                    <RungSection rung={rung} isVerdict={false} lang={lang} strings={strings} />
                  </details>
                ))
            }
          </section>

          <section id="sources" class="entry__sources">
            {
              entry.further_reading.length > 0 && (
                <>
                  <h2>{strings.entry.furtherReading}</h2>
                  <ul>
                    {entry.further_reading.map((l: any) => (
                      <li>
                        <a href={l.url} rel="noopener">{l.label}</a>
                      </li>
                    ))}
                  </ul>
                </>
              )
            }

            {
              entry.sources.length > 0 && (
                <>
                  <h2>{strings.entry.sources}</h2>
                  <ul>
                    {entry.sources.map((l: any) => (
                      <li>
                        <a href={l.url} rel="noopener">{l.label}</a>
                      </li>
                    ))}
                  </ul>
                </>
              )
            }

            <h2>{strings.entry.metadata}</h2>
            <dl class="entry__meta">
              <div>
                <dt>{strings.entry.family}</dt>
                <dd><a href={route(lang, 'families', entry.family)}>{familyTitle}</a></dd>
              </div>
              <div>
                <dt>{strings.entry.updated}</dt>
                <dd>{dateFormat.format(updated)}</dd>
              </div>
              <div>
                <dt>{strings.entry.contributors}</dt>
                <dd>{entry.contributors.join(', ')}</dd>
              </div>
            </dl>

            {hasRegulatory && <LegalNotice strings={strings} />}
          </section>

          {
            neighbours.length > 0 && (
              <nav class="entry__neighbours" aria-labelledby="neighbours-title">
                <h2 id="neighbours-title">{strings.entry.neighbours}</h2>
                <ul>
                  {neighbours.map((n) => (
                    <li>
                      <a href={n.href}>{n.title}</a>
                    </li>
                  ))}
                </ul>
              </nav>
            )
          }
        </div>
      </div>
    </div>

    <div class="entry__help">
      <div class="wrap">
        <HelpBlock strings={strings} source={entry.title[lang]} />
      </div>
    </div>
  </article>
</SiteLayout>

<script>
  import '../scripts/code-tabs.js';
</script>

<style>
  .entry__head {
    padding-block: var(--space-10) var(--space-12);
    margin-block-end: var(--space-12);
  }

  .entry__answer {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.2rem, 6vw, 4.2rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
    max-width: 17ch;
    margin-block: var(--space-8) 0;
  }

  .entry__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-start: var(--space-6);
  }

  .entry__facts span {
    font-size: 0.83rem;
    font-weight: 500;
    padding: 7px 14px;
    border: 1.5px solid rgba(22, 19, 14, 0.28);
    border-radius: 999px;
  }

  .entry__h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-block: var(--space-16) var(--space-5);
  }

  /* Les quatre options, en cartes : un tableau a sept colonnes ne se lit pas. */
  .scale {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--space-4);
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    position: relative;
    padding: var(--space-6);
    border: 1px solid var(--rule-strong);
    border-radius: 14px;
  }

  .step--on {
    border: 2px solid var(--go);
    padding: calc(var(--space-6) - 1px);
  }

  .step--off { opacity: 0.55; }
  .step--off .step__name { text-decoration: line-through; }

  .step__tag {
    position: absolute;
    inset-block-start: -10px;
    inset-inline-start: 18px;
    background: var(--go);
    color: var(--paper);
    font-size: 0.7rem;
    font-weight: 600;
    padding: 5px 10px;
    border-radius: 999px;
  }

  .step__n {
    font-family: var(--font-code);
    font-size: 0.72rem;
    color: var(--muted);
  }

  .step__name {
    font-weight: 600;
    font-size: 0.97rem;
    line-height: 1.35;
  }

  .step__f {
    margin-block-start: auto;
    padding-block-start: var(--space-3);
    font-size: 0.8rem;
    color: var(--muted);
  }

  .entry__why-text {
    font-size: 1.22rem;
    line-height: 1.62;
    max-width: 58ch;
    margin-block: var(--space-8) var(--space-12);
  }

  .entry__others {
    margin-block-start: var(--space-16);
    padding-block-start: var(--space-8);
    border-block-start: 1px solid var(--rule-strong);
  }

  .entry__fold {
    border-block-end: 1px solid var(--rule);
  }

  .entry__fold summary {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-5);
    cursor: pointer;
    list-style: none;
  }

  .entry__fold summary::-webkit-details-marker { display: none; }

  .entry__fold summary::after {
    content: '+';
    margin-inline-start: auto;
    font-family: var(--font-code);
    color: var(--muted);
  }

  .entry__fold[open] summary::after { content: '−'; }

  .entry__fold-level {
    font-family: var(--font-code);
    font-size: 0.78rem;
    color: var(--muted);
    flex: none;
  }

  .entry__fold-name {
    font-weight: 600;
  }

  .entry__fold-facts {
    font-size: 0.8rem;
    color: var(--muted);
  }


  .entry__breadcrumb {
    display: flex;
    gap: var(--space-2);
    font-size: var(--size-small);
    color: var(--muted);
    margin: 0 0 var(--space-3);
    max-width: none;
  }

  .entry__title {
    max-width: 20ch;
  }

  .entry__need {
    margin-block-start: var(--space-3);
    font-size: var(--size-h3);
  }

  .entry__badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-block-start: var(--space-6);
    margin-block-end: 0;
    max-width: none;
  }

  .entry__draft {
    border: 1px dashed var(--ink);
    border-radius: var(--radius-pill);
    padding: var(--space-1) var(--space-3);
    font-size: var(--size-small);
  }

  .entry__updated {
    font-size: var(--size-small);
    color: var(--muted);
  }

  .entry__draft-note {
    margin-block-end: var(--space-8);
  }

  .entry__body > * + * {
    margin-block-start: var(--space-8);
  }

  .entry__verdict,
  .entry__sources,
  .entry__neighbours {
    border-block-start: 1px solid var(--rule);
    padding-block-start: var(--space-8);
  }

  .entry__verdict-badge {
    margin-block: var(--space-4);
    max-width: none;
  }

  .entry__sources h2,
  .entry__neighbours h2 {
    font-family: var(--font-text);
    font-size: var(--size-h3);
    font-weight: var(--weight-h3);
    margin-block: var(--space-6) var(--space-2);
  }

  .entry__sources ul,
  .entry__neighbours ul {
    padding-inline-start: var(--space-4);
    font-size: var(--size-small);
  }

  .entry__meta {
    display: grid;
    gap: var(--space-2);
    font-size: var(--size-small);
    margin: 0;
  }

  .entry__meta div {
    display: flex;
    gap: var(--space-3);
  }

  .entry__meta dt {
    color: var(--muted);
    min-width: 10rem;
  }

  .entry__meta dd {
    margin: 0;
  }

  .entry__help {
    margin-block-start: var(--space-16);
  }
</style>

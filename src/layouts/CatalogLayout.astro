---
/**
 * Gabarit du catalogue (CDC 7.3).
 *
 * La liste complète est rendue au build. La recherche et les filtres
 * l'enrichissent, ils ne la produisent pas : sans JavaScript, la page reste
 * une liste utilisable, et le formulaire de filtres fonctionne par
 * rechargement.
 */
import SiteLayout from './SiteLayout.astro';
import EntryCard from '../components/EntryCard.astro';
import CtaBand from '../components/CtaBand.astro';
import EmptyState from '../components/EmptyState.astro';
import { t, type Locale } from '../i18n';
import { route } from '../i18n/routes';
import { FAMILIES, LEVELS, DATA_EGRESS } from '../content/schema/enums';

export interface Props {
  lang: Locale;
  title: string;
  lead?: string;
  entries: any[];
  familyTitles: Record<string, string>;
  issueUrl: string;
  /** État initial des filtres, lu dans les paramètres d'URL au build. */
  activeFilters?: Record<string, string>;
}

const {
  lang, title, lead, entries, familyTitles, issueUrl, activeFilters = {},
} = Astro.props;
const strings = t(lang);

/** Les fiches groupées par famille, dans l'ordre des familles. */
const groupes = FAMILIES
  .map((f) => [f, entries.filter((e: any) => e.family === f)] as const)
  .filter(([, fiches]) => fiches.length > 0);

const filtres = [
  {
    nom: 'family',
    libelle: strings.catalogue.filterFamily,
    aucun: strings.catalogue.anyFamily,
    options: FAMILIES.map((f) => [f, familyTitles[f] ?? f] as const),
  },
  {
    nom: 'verdict',
    libelle: strings.catalogue.filterVerdict,
    aucun: strings.catalogue.anyVerdict,
    options: LEVELS.map((l) => [l, `${l} — ${strings.rung.short[l]}`] as const),
  },
  {
    nom: 'egress',
    libelle: strings.catalogue.filterEgress,
    aucun: strings.catalogue.anyEgress,
    options: DATA_EGRESS.map((e) => [e, strings.riskValue.data_egress[e]] as const),
  },
  {
    nom: 'deterministic',
    libelle: strings.catalogue.filterDeterministic,
    aucun: strings.catalogue.anyDeterministic,
    options: [
      ['true', strings.riskValue.deterministic.true],
      ['false', strings.riskValue.deterministic.false],
    ] as const,
  },
];
---

<SiteLayout title={title} description={lead} lang={lang} register="documentary">
  <div class="wrap catalogue">
    <header class="catalogue__head">
      <h1 class="display-l">{title}</h1>
      {lead && <p class="catalogue__lead">{lead}</p>}
    </header>

    {/* La recherche a besoin de JavaScript ; les filtres, non. Les deux vivent
        dans un formulaire qui se soumet en GET, ce qui garde la page utilisable
        et l'état partageable par l'URL (CDC 9.2). */}
    <form
      class="catalogue__controls"
      method="get"
      data-catalogue-form
      data-search-index={`/${lang}/search-index.json`}
    >
      <div class="catalogue__search">
        <label for="q">{strings.catalogue.search}</label>
        <input
          type="search"
          id="q"
          name="q"
          autocomplete="off"
          placeholder={strings.catalogue.searchPlaceholder}
          value={activeFilters.q ?? ''}
          data-search-input
        />
        <p class="catalogue__nojs small">{strings.catalogue.noJs}</p>
      </div>

      <fieldset class="catalogue__filters">
        <legend class="visually-hidden">{strings.catalogue.filters}</legend>
        {
          filtres.map((f) => (
            <p class="catalogue__filter">
              <label for={f.nom}>{f.libelle}</label>
              <select id={f.nom} name={f.nom} data-filter={f.nom}>
                <option value="">{f.aucun}</option>
                {f.options.map(([valeur, libelle]) => (
                  <option value={valeur} selected={activeFilters[f.nom] === valeur}>
                    {libelle}
                  </option>
                ))}
              </select>
            </p>
          ))
        }
        <p class="catalogue__submit">
          <button type="submit">{strings.catalogue.apply}</button>
          <a href={route(lang, 'catalogue')}>{strings.catalogue.reset}</a>
        </p>
      </fieldset>
    </form>

    <p class="catalogue__count" data-result-count aria-live="polite">
      <span data-count>{entries.length}</span>
      {entries.length === 1 ? strings.catalogue.resultsOne : strings.catalogue.results}
    </p>

    <ul class="catalogue__list" data-entry-list>
      {
        groupes.map(([famille, fiches]) => [
          ...fiches.map((e: any) => (
          <EntryCard
            id={e.id}
            href={route(lang, 'entries', e.id)}
            title={e.title[lang]}
            need={e.need[lang]}
            familyLabel={familyTitles[e.family] ?? e.family}
            family={e.family}
            verdict={e.verdict}
            available={e.rungs.filter((r: any) => r.available).map((r: any) => r.level)}
            egress={e.rungs.find((r: any) => r.level === e.verdict)?.risks.data_egress ?? 'none'}
            deterministic={
              e.rungs.find((r: any) => r.level === e.verdict)?.risks.deterministic ?? true
            }
            cost={e.rungs.find((r: any) => r.level === e.verdict)?.cost}
            latency={e.rungs.find((r: any) => r.level === e.verdict)?.latency}
            strings={strings}
            draft={e.status === 'draft'}
          />
          )),
        ])
      }
    </ul>

    <EmptyState strings={strings} issueUrl={issueUrl} />
  </div>

  <CtaBand
    heading={strings.families.ctaHeading}
    body={strings.families.ctaBody}
    action={{ label: strings.families.browse, href: route(lang, 'families') }}
    secondary={{ label: strings.family.missingAction, href: issueUrl, external: true }}
  />
</SiteLayout>

<script>
  import '../scripts/catalogue.js';
</script>

<style>
  .catalogue {
    padding-block: var(--space-12) var(--space-16);
  }

  .catalogue__head {
    margin-block-end: var(--space-8);
  }

  .catalogue__group {
    margin-block: var(--space-8) var(--space-2);
    padding-block-end: var(--space-2);
    border-block-end: 1px solid var(--rule-strong);
  }

  .catalogue__group:first-child {
    margin-block-start: var(--space-4);
  }

  .catalogue__group h2 {
    font-size: var(--size-small);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--muted);
    margin: 0;
  }



  .catalogue__filters {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-3);
    border: 0;
    margin: 0;
    padding: 0;
  }

  .catalogue__filter {
    margin: 0;
    flex: 0 1 13rem;
    min-width: 0;
  }

  .catalogue__filter label {
    display: block;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--muted);
    margin-block-end: 6px;
  }

  /* La flèche est dessinée en CSS : deux triangles qui se rejoignent. */
  .catalogue__filter select {
    width: 100%;
    appearance: none;
    -webkit-appearance: none;
    font: inherit;
    font-size: 0.92rem;
    line-height: 1.2;
    padding: 11px 34px 11px 14px;
    border: 1px solid var(--rule-strong);
    border-radius: 12px;
    background-color: var(--paper-2);
    background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='12' height='8' viewBox='0 0 12 8'><path d='M1 1.5 6 6.5 11 1.5' fill='none' stroke='%2316130E' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'/></svg>");
    background-position: right 14px center;
    background-size: 12px 8px;
    background-repeat: no-repeat;
    color: var(--ink);
    cursor: pointer;
    transition: border-color 140ms ease, background-color 140ms ease;
  }

  .catalogue__filter select:hover {
    border-color: var(--ink);
  }

  .catalogue__filter select:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  /* Discret, et absent tant qu'aucun filtre n'est actif. */
  .catalogue__submit {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0;
  }

  .catalogue__submit a {
    font: inherit;
    font-size: 0.92rem;
    line-height: 1.2;
    padding: 11px 14px;
    border: 1px solid var(--rule-strong);
    border-radius: 12px;
    background-color: var(--paper-2);
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
    transition: border-color 140ms ease;
  }

  .catalogue__submit a:hover {
    border-color: var(--ink);
    background-color: var(--paper-2);
  }

  .catalogue__submit a:hover {
    background: var(--paper-2);
    color: var(--ink);
  }

  .catalogue__controls[data-enhanced='true'] .catalogue__submit button {
    display: none;
  }

  .catalogue__controls[data-enhanced='true']:not([data-filtered='true']) .catalogue__submit {
    display: none;
  }

  :global([data-theme='dark']) .catalogue__filter select {
    background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='12' height='8' viewBox='0 0 12 8'><path d='M1 1.5 6 6.5 11 1.5' fill='none' stroke='%23F5F0E4' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'/></svg>");
  }

  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme='light'])) .catalogue__filter select {
      background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='12' height='8' viewBox='0 0 12 8'><path d='M1 1.5 6 6.5 11 1.5' fill='none' stroke='%23F5F0E4' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'/></svg>");
    }
  }

  .catalogue__lead {
    margin-block-start: var(--space-3);
    color: var(--muted);
  }

  .catalogue__controls {
    display: grid;
    gap: var(--space-6);
    padding-block-end: var(--space-6);
    border-block-end: 1px solid var(--rule-strong);
  }

  .catalogue__search label {
    display: block;
    font-size: var(--size-small);
    color: var(--muted);
    margin-block-end: var(--space-2);
  }

  .catalogue__search input {
    font: inherit;
    font-size: var(--size-h3);
    width: 100%;
    max-width: 32rem;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-block);
    background: var(--paper);
    color: var(--ink);
  }

  /* Le message n'apparaît que quand le JavaScript n'a pas pris la main. */
  .catalogue__nojs {
    color: var(--muted);
    margin-block: var(--space-2) 0;
  }

  [data-catalogue-form][data-enhanced='true'] .catalogue__nojs {
    display: none;
  }

  .catalogue__filters {
    border: 0;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: flex-end;
  }

  .catalogue__filter {
    margin: 0;
    max-width: none;
  }

  .catalogue__filter label {
    display: block;
    font-size: var(--size-small);
    color: var(--muted);
    margin-block-end: var(--space-1);
  }


  .catalogue__submit {
    margin: 0;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    font-size: var(--size-small);
  }

  .catalogue__submit button {
    font: inherit;
    font-size: var(--size-small);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--ink);
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--paper);
    cursor: pointer;
  }

  /* Le bouton ne sert qu'en dégradé : avec JavaScript, le filtrage est
     instantané et le rechargement serait une régression. */
  [data-catalogue-form][data-enhanced='true'] .catalogue__submit button {
    display: none;
  }

  .catalogue__count {
    margin-block: var(--space-6) 0;
    font-size: var(--size-small);
    color: var(--muted);
  }

  .catalogue__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));
    gap: var(--space-4);
    align-items: stretch;
    list-style: none;
    margin: 0;
    padding: 0;
    border-block-end: 1px solid var(--rule);
  }

  .catalogue__list:has(> li:not([hidden])) + [data-empty-state] {
    display: none;
  }
</style>

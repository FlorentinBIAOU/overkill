---
/**
 * Le bloc d'accompagnement (CDC 7.9).
 *
 * L'adresse est obfusquée au rendu pour limiter l'aspiration automatique, tout
 * en restant cliquable et lisible sans JavaScript : le lien porte un `href`
 * construit en entités HTML, et le texte visible est écrit à l'envers puis
 * remis à l'endroit par le CSS. Un aspirateur qui lit le HTML brut ne trouve
 * ni chaîne « @ » exploitable dans le texte, ni adresse en clair.
 *
 * L'objet du message reprend le titre de la fiche d'origine, pour tracer la
 * provenance.
 */
import type { Strings } from '../i18n';

export interface Props {
  strings: Strings;
  /** Titre de la fiche d'origine, repris dans l'objet du message. */
  source?: string;
  compact?: boolean;
}

const { strings, source, compact = false } = Astro.props;

const USER = 'biaouflo';
const DOMAIN = 'gmail.com';
const address = `${USER}@${DOMAIN}`;

const subject = source
  ? `${strings.help.subjectPrefix} — ${source}`
  : strings.help.subjectPrefix;

/**
 * Encode chaque caractère en référence numérique. Un navigateur les décode au
 * moment de l'analyse du document, y compris dans la valeur d'un attribut :
 * le lien fonctionne donc sans JavaScript. Un aspirateur qui cherche un motif
 * d'adresse dans le HTML brut, lui, ne trouve rien.
 */
const entities = (text: string) =>
  [...text].map((c) => `&#${c.codePointAt(0)};`).join('');

const href = `${entities(`mailto:${address}`)}?subject=${encodeURIComponent(subject)}`;

/**
 * Le texte visible est écrit à l'envers dans le HTML et remis à l'endroit par
 * le CSS. Sans CSS il reste lisible, à l'envers, et le lien fonctionne.
 *
 * L'ancre entière est produite comme une chaîne : Astro échapperait sinon les
 * esperluettes des références numériques de l'attribut `href`, ce qui casserait
 * le lien.
 */
const reversed = [...address].reverse().join('');
const anchor =
  `<a class="help__link" href="${href}">` +
  `<span class="help__address">${reversed}</span>` +
  `</a>`;
---

<aside class:list={['help', compact && 'help--compact']}>
  <h2 class="help__title">{strings.help.heading}</h2>
  <p class="help__body">{strings.help.body}</p>
  <p class="help__action" set:html={anchor} />
</aside>

<style>
  .help {
    background: var(--brand);
    color: var(--on-brand);
    padding: var(--space-8);
    border-radius: var(--radius-flat);
  }

  .help--compact {
    padding: var(--space-6);
  }

  .help__title {
    font-family: var(--font-display);
    font-size: var(--size-h2);
    font-weight: 700;
    line-height: var(--lh-heading);
    margin: 0 0 var(--space-3);
    max-width: 20ch;
  }

  .help__body,
  .help__action {
    margin: 0 0 var(--space-3);
  }

  .help__action {
    margin-block-end: 0;
  }

  .help__link {
    font-family: var(--font-code);
    font-weight: 600;
    color: var(--on-brand);
  }

  /* Le texte est écrit à l'envers dans le HTML et remis à l'endroit ici.
     Sans CSS il reste lisible, à l'envers, et le lien fonctionne. */
  .help__address {
    unicode-bidi: bidi-override;
    direction: rtl;
  }
</style>

---
/**
 * Le bloc d'accompagnement (CDC 7.9), en appel à l'action de fin de page.
 *
 * Même traitement que les autres pages du site : aplat jaune pleine largeur,
 * grand titre, bouton sombre. Voir FamilyLayout et CatalogLayout.
 *
 * L'adresse est obfusquée au rendu pour limiter l'aspiration automatique, tout
 * en restant cliquable et lisible sans JavaScript : le lien porte un `href`
 * construit en entités HTML, et le texte visible est écrit à l'envers puis
 * remis à l'endroit par le CSS. Un aspirateur qui lit le HTML brut ne trouve
 * ni chaîne « @ » exploitable dans le texte, ni adresse en clair.
 *
 * L'objet du message reprend le titre de la fiche d'origine, pour tracer la
 * provenance.
 */
import type { Strings } from '../i18n';

export interface Props {
  strings: Strings;
  /** Titre de la fiche d'origine, repris dans l'objet du message. */
  source?: string;
  /** Version resserrée, pour une colonne : sans aplat ni grand titre. */
  compact?: boolean;
}

const { strings, source, compact = false } = Astro.props;

const USER = 'biaouflo';
const DOMAIN = 'gmail.com';
const address = `${USER}@${DOMAIN}`;

const subject = source
  ? `${strings.help.subjectPrefix} — ${source}`
  : strings.help.subjectPrefix;

/**
 * Encode chaque caractère en référence numérique. Un navigateur les décode au
 * moment de l'analyse du document, y compris dans la valeur d'un attribut :
 * le lien fonctionne donc sans JavaScript. Un aspirateur qui cherche un motif
 * d'adresse dans le HTML brut, lui, ne trouve rien.
 */
const entities = (text: string) =>
  [...text].map((c) => `&#${c.codePointAt(0)};`).join('');

const href = `${entities(`mailto:${address}`)}?subject=${encodeURIComponent(subject)}`;

/**
 * Le texte visible est écrit à l'envers dans le HTML et remis à l'endroit par
 * le CSS. Sans CSS il reste lisible, à l'envers, et le lien fonctionne.
 *
 * L'ancre entière est produite comme une chaîne : Astro échapperait sinon les
 * esperluettes des références numériques de l'attribut `href`, ce qui
 * casserait le lien. Conséquence à ne pas oublier : le CSS de portée
 * automatique d'Astro ne marque pas le balisage injecté ainsi, donc les règles
 * qui visent ces classes sont déclarées globales. Sans cela l'adresse
 * s'affiche à l'envers — ce qu'une capture d'écran a montré.
 */
const reversed = [...address].reverse().join('');
const bouton =
  `<a class="help__button" href="${href}">` +
  `${strings.help.action}</a>` +
  `<span class="help__address">${reversed}</span>`;
---

{
  compact ? (
    <aside class="help help--compact" aria-label={strings.help.heading}>
      <h2 class="help__title-compact">{strings.help.heading}</h2>
      <p class="help__body">{strings.help.body}</p>
      <p class="help__actions" set:html={bouton} />
    </aside>
  ) : (
    <aside class="help band band-brand" aria-label={strings.help.heading}>
      <div class="wrap">
        <h2 class="display-l help__title">{strings.help.heading}</h2>
        <p class="help__body">{strings.help.body}</p>
        <p class="help__actions" set:html={bouton} />
      </div>
    </aside>
  )
}

<style>
  .help {
    background: var(--brand);
    color: var(--on-brand);
  }

  .help:not(.help--compact) {
    padding-block: var(--space-16);
  }

  .help--compact {
    padding: var(--space-6);
    border-radius: var(--radius-flat);
  }

  .help__title {
    max-width: 24ch;
  }

  .help__title-compact {
    font-family: var(--font-display);
    font-size: var(--size-h2);
    font-weight: 700;
    line-height: var(--lh-heading);
    margin: 0 0 var(--space-3);
    max-width: 20ch;
  }

  .help__body {
    margin: var(--space-5) 0 0;
    max-width: 46ch;
  }

  .help--compact .help__body {
    margin-block-start: 0;
    margin-block-end: var(--space-3);
  }

  .help__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    margin: var(--space-8) 0 0;
    max-width: none;
  }

  .help--compact .help__actions {
    margin-block-start: var(--space-4);
  }

  /* Le bouton sombre de l'aplat jaune, comme sur le catalogue et les
     familles. Déclaré global : l'ancre est injectée en HTML, donc elle ne
     porte pas la marque de portée d'Astro. */
  .help :global(.help__button) {
    display: inline-block;
    padding: var(--space-3) var(--space-6);
    background: var(--on-brand);
    color: var(--on-brand-text);
    border-radius: var(--radius-pill);
    font-weight: 600;
    text-decoration: none;
    min-height: 44px;
  }

  .help :global(.help__button:hover) {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  /* Le texte est écrit à l'envers dans le HTML et remis à l'endroit ici. */
  .help :global(.help__address) {
    font-family: var(--font-code);
    font-size: var(--size-small);
    unicode-bidi: bidi-override;
    direction: rtl;
  }
</style>

---
/**
 * Une ligne du catalogue : titre, famille, badge de verdict, mini-échelle des
 * barreaux documentés (CDC 7.3).
 *
 * Un seul composant, réutilisé par le catalogue et par les pages de famille.
 * Les attributs de données portent l'état filtrable, pour que les filtres
 * agissent sur le DOM déjà rendu sans refaire de requête.
 */
import VerdictBadge from './VerdictBadge.astro';
import type { Strings } from '../i18n';
import type { Level } from '../content/schema/enums';

export interface Props {
  /** Identifiant de la fiche : la clé qui relie l'index de recherche au DOM. */
  id: string;
  href: string;
  title: string;
  familyLabel: string;
  family: string;
  verdict: Level;
  available: Level[];
  /** Sortie de données du barreau recommandé, pour le filtre. */
  egress: 'none' | 'own-infra' | 'third-party';
  deterministic: boolean;
  strings: Strings;
  draft?: boolean;
}

const {
  id, href, title, familyLabel, family, verdict, available, egress, deterministic, strings,
  draft = false,
} = Astro.props;
---

<li
  class="entry-card"
  data-entry
  data-entry-id={id}
  data-family={family}
  data-verdict={verdict}
  data-egress={egress}
  data-deterministic={String(deterministic)}
>
  <a class="entry-card__link" href={href}>
    <span class="entry-card__title">{title}</span>
  </a>

  <span class="entry-card__meta">
    {draft && <span class="entry-card__draft">{strings.entry.draft}</span>}
  </span>

  <span class="entry-card__verdict">
    <VerdictBadge label={strings.rung.answer[verdict]} level={verdict} />
  </span>
</li>

<style>
  .entry-card {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-3);
    border-block-start: 1px solid var(--rule);
    max-width: none;
  }

  .entry-card__link {
    flex: 1 1 18rem;
    text-decoration: none;
  }

  .entry-card__link:hover .entry-card__title,
  .entry-card__link:focus-visible .entry-card__title {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .entry-card__title {
    font-weight: 600;
  }

  .entry-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--size-small);
    color: var(--muted);
    flex: 0 1 12rem;
  }

  .entry-card__draft {
    border: 1px dashed var(--rule-strong);
    border-radius: var(--radius-pill);
    padding: 0 var(--space-2);
  }

  .entry-card__verdict {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-inline-start: auto;
  }
</style>

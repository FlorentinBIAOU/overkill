---
/**
 * Une ligne du catalogue : titre, famille, badge de verdict, mini-échelle des
 * barreaux documentés (CDC 7.3).
 *
 * Un seul composant, réutilisé par le catalogue et par les pages de famille.
 * Les attributs de données portent l'état filtrable, pour que les filtres
 * agissent sur le DOM déjà rendu sans refaire de requête.
 */
import VerdictBadge from './VerdictBadge.astro';
import RungIcon from './icons/RungIcon.astro';
import type { Strings } from '../i18n';
import type { Level } from '../content/schema/enums';

export interface Props {
  /** Identifiant de la fiche : la clé qui relie l'index de recherche au DOM. */
  id: string;
  href: string;
  title: string;
  /** Le besoin en une phrase. */
  need?: string;
  cost: string;
  latency: string;
  familyLabel: string;
  family: string;
  verdict: Level;
  available: Level[];
  /** Sortie de données du barreau recommandé, pour le filtre. */
  egress: 'none' | 'own-infra' | 'third-party';
  deterministic: boolean;
  strings: Strings;
  draft?: boolean;
  /**
   * Vrai quand la carte appartient à une autre page du catalogue. Elle est
   * alors dans le HTML mais masquée : c'est ce qui permet aux filtres de
   * porter sur le catalogue entier sans recharger la page, tout en laissant la
   * pagination fonctionner sans JavaScript.
   */
  offPage?: boolean;
}

const {
  id, href, title, need, cost, latency, familyLabel, family, verdict, available, egress, deterministic, strings,
  draft = false, offPage = false,
} = Astro.props;
---

<li
  class={`card card--${verdict.toLowerCase()}`}
  data-entry
  data-off-page={offPage ? 'true' : undefined}
  hidden={offPage}
  data-entry-id={id}
  data-family={family}
  data-verdict={verdict}
  data-egress={egress}
  data-deterministic={String(deterministic)}
>
  <a class="card__link" href={href}>
    <span class="card__title">{title}</span>
    {need && <span class="card__need">{need}</span>}
    {draft && <span class="card__draft">{strings.entry.draft}</span>}

    <span class="card__answer">{strings.rung.answer[verdict]}</span>

    {/* Au survol : ce qu'il fallait ouvrir la fiche pour savoir. */}
    <span class="card__facts">
      <span>{strings.plainCost[cost] ?? cost}</span>
      <span>{strings.plainLatency[latency] ?? latency}</span>
      <span>{strings.plainEgress[egress] ?? egress}</span>
    </span>
  </a>
</li>

<style>
  .card {
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: var(--paper);
    transition: border-color 160ms ease, transform 160ms ease;
  }

  .card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-6);
    text-decoration: none;
    color: inherit;
  }

  .card__title {
    font-size: 1.12rem;
    font-weight: 600;
    line-height: 1.32;
  }

  .card__need {
    margin-block-start: var(--space-3);
    font-size: var(--size-small);
    line-height: 1.55;
    color: var(--muted);
  }

  .card__draft {
    margin-block-start: var(--space-2);
    font-size: var(--size-small);
    color: var(--muted);
  }

  /* La réponse porte la couleur du niveau : elle marque le cran,
     elle ne juge pas la solution (CDC 8.3). */
  .card__answer {
    margin-block-start: auto;
    padding-block-start: var(--space-5);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--ans-0);
  }

  .card--n1 .card__answer { color: var(--ans-1); }
  .card--n2 .card__answer { color: var(--ans-2); }
  .card--n3 .card__answer { color: var(--ans-3); }

  .card__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    font-size: 0.76rem;
    color: var(--muted);
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height 180ms ease, opacity 180ms ease,
                margin-block-start 180ms ease;
  }

  .card:hover,
  .card:focus-within {
    border-color: var(--rule-strong);
    transform: translateY(-2px);
  }

  .card:hover .card__facts,
  .card:focus-within .card__facts {
    max-height: 4rem;
    opacity: 1;
    margin-block-start: var(--space-3);
  }

  .card:hover .card__title,
  .card:focus-within .card__title {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .card, .card__facts { transition: none; }
    .card:hover, .card:focus-within { transform: none; }
  }
</style>



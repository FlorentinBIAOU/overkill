---
/**
 * Un bloc de code, colorisé à la construction du site.
 *
 * Shiki tourne au build : le lecteur reçoit du HTML déjà coloré, jamais un
 * flash de code brut suivi d'une colorisation (CDC 10.1). Aucun numéro de
 * ligne (CDC 7.5). Rayon de 4 px, celui des blocs de code et des tableaux.
 */
import { codeToHtml } from 'shiki';
import type { Language } from '../lib/snippets';

export interface Props {
  code: string;
  language: Language;
  /** Chemin du fichier réel, affiché sous le bloc. */
  path?: string;
  copyLabel: string;
  copiedLabel: string;
  failedLabel: string;
}

const { code, language, path, copyLabel, copiedLabel, failedLabel } = Astro.props;

// Un seul rendu, deux thèmes portés par des variables CSS : le mode sombre ne
// coûte pas un second bloc de HTML, ce qui compte pour le budget de la fiche.
//
// Les thèmes à contraste renforcé, et non les thèmes par défaut : l'audit
// d'accessibilité a montré que la couleur des commentaires de « github-light »
// et « github-dark » passe sous le seuil AA sur notre fond de bloc de code.
// Le code est le contenu le plus important du site, il ne peut pas être le
// moins lisible.
const rendu = await codeToHtml(code, {
  lang: language === 'python' ? 'python' : 'javascript',
  themes: { light: 'github-light-high-contrast', dark: 'github-dark-high-contrast' },
  defaultColor: false,
  cssVariablePrefix: '--sk-',
});

/*
 * Substitutions de couleur, mesurées.
 *
 * Le fond des blocs de code est --paper-2 (#F4EFE2), et non le fond blanc que
 * suppose le thème. Une seule couleur du thème clair passe alors sous le seuil
 * AA sur ce fond : le gris des commentaires, à 4,39:1 pour un minimum de 4,5.
 *
 * Elle est remplacée par --muted (#6B6252), qui vient de notre propre palette
 * et donne 5,23:1. Les six autres couleurs du thème sont entre 7,0 et 16,5:1
 * et ne bougent pas.
 *
 * Vérifié par scripts/check-a11y.mjs, en clair et en sombre.
 */
const SUBSTITUTIONS: Record<string, string> = {
  '#66707B': '#6B6252',
};

const html = Object.entries(SUBSTITUTIONS).reduce(
  (sortie, [avant, apres]) => sortie.replaceAll(`--sk-light:${avant}`, `--sk-light:${apres}`),
  rendu,
);
---

<figure class="code-block">
  <div class="code-block__bar">
    {path && <code class="code-block__path">{path}</code>}
    <button
      type="button"
      class="code-block__copy"
      data-copy
      data-label-copy={copyLabel}
      data-label-copied={copiedLabel}
      data-label-failed={failedLabel}
    >
      {copyLabel}
    </button>
  </div>
  <div class="code-block__code scroll-x" set:html={html} />
</figure>

<style>
  .code-block {
    margin: 0;
    border: 1px solid var(--rule);
    border-radius: var(--radius-block);
    background: var(--code-bg);
    overflow: hidden;
  }

  .code-block__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-block-end: 1px solid var(--rule);
    min-height: 36px;
  }

  .code-block__path {
    font-size: var(--size-small);
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .code-block__copy {
    font: inherit;
    font-size: var(--size-small);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-pill);
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
    flex: none;
  }

  .code-block__copy:hover {
    border-color: var(--ink);
  }

  .code-block__code {
    padding: var(--space-4);
  }

  /* Shiki rend deux jeux de couleurs ; on choisit selon le thème. */
  .code-block__code :global(pre) {
    margin: 0;
    background: transparent !important;
    color: var(--sk-light, inherit);
  }

  .code-block__code :global(span) {
    color: var(--sk-light, inherit);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .code-block__code :global(pre),
    :global(:root:not([data-theme='light'])) .code-block__code :global(span) {
      color: var(--sk-dark, inherit);
    }
  }

  :global(:root[data-theme='dark']) .code-block__code :global(pre),
  :global(:root[data-theme='dark']) .code-block__code :global(span) {
    color: var(--sk-dark, inherit);
  }
</style>

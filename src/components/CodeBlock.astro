---
/**
 * Un bloc de code, colorisé à la construction du site, posé sur fond sombre.
 *
 * Shiki tourne au build : le lecteur reçoit du HTML déjà coloré, jamais un
 * flash de code brut suivi d'une colorisation (CDC 10.1). Aucun numéro de
 * ligne (CDC 7.5). Rayon de 4 px, celui des blocs de code et des tableaux.
 *
 * Le fond est sombre et **fixe** : il ne suit pas le thème clair/sombre. Un
 * éditeur ne change pas de couleur parce que la page change de thème, et c'est
 * le seul contraste fort de la fiche. Conséquence technique : un seul thème de
 * coloration à rendre, donc un seul jeu de couleurs dans le HTML, là où le
 * double rendu clair/sombre en posait deux sur chaque jeton.
 */
import { codeToHtml } from 'shiki';
import { CODE_THEME, substitute } from '../lib/code-theme.mjs';
import type { Language } from '../lib/snippets';

export interface Props {
  code: string;
  language: Language;
  /** Chemin du fichier réel, affiché dans la barre du bloc. */
  path?: string;
  copyLabel: string;
  copiedLabel: string;
  failedLabel: string;
  /**
   * Mention discrète posée dans la barre, au plus près du code : ce que la
   * preuve d'exécution de cet extrait vaut réellement (partie 1.4 du lot).
   */
  proof?: { short: string; title: string };
}

const { code, language, path, copyLabel, copiedLabel, failedLabel, proof } = Astro.props;

/* Le thème et ses substitutions vivent dans src/lib/code-theme.mjs : le
   contrôle de contraste les relit pour vérifier chaque couleur du thème
   contre --code-surface. */
const html = substitute(
  await codeToHtml(code, {
    lang: language === 'python' ? 'python' : 'javascript',
    theme: CODE_THEME,
  }),
);
---

<figure class="code-block">
  <div class="code-block__bar">
    {path && <code class="code-block__path">{path}</code>}
    {
      proof && (
        <span class="code-block__proof" title={proof.title}>
          {proof.short}
          <span class="visually-hidden"> — {proof.title}</span>
        </span>
      )
    }
    <button
      type="button"
      class="code-block__copy"
      data-copy
      data-label-copy={copyLabel}
      data-label-copied={copiedLabel}
      data-label-failed={failedLabel}
    >
      {copyLabel}
    </button>
  </div>
  <div class="code-block__code scroll-x" set:html={html} />
</figure>

<style>
  /* Fond sombre fixe dans les deux thèmes : voir tokens.css. */
  .code-block {
    margin: 0;
    border-radius: var(--radius-block);
    background: var(--code-surface);
    color: var(--code-on-surface);
    overflow: hidden;
  }

  .code-block__bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-block-end: 1px solid var(--code-rule);
    min-height: 40px;
  }

  .code-block__path {
    font-size: 0.78rem;
    color: var(--code-on-surface-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* La preuve d'exécution, au plus près du code et non en bloc explicatif :
     le lecteur qui la cherche la trouve, la page ne la lui assène pas. */
  .code-block__proof {
    font-size: 0.72rem;
    line-height: 1.3;
    color: var(--code-on-surface-muted);
    border: 1px solid var(--code-rule);
    border-radius: var(--radius-pill);
    padding: 3px 9px;
    white-space: nowrap;
    cursor: help;
    flex: none;
  }

  .code-block__copy {
    font: inherit;
    font-size: 0.78rem;
    line-height: 1.3;
    margin-inline-start: auto;
    padding: 7px 13px;
    border: 1px solid var(--code-rule);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--code-on-surface);
    cursor: pointer;
    flex: none;
    min-height: 32px;
  }

  .code-block__copy:hover {
    border-color: var(--code-on-surface-muted);
    background: var(--code-rule);
  }

  /* L'anneau de focus du site est l'encre, invisible sur ce fond. */
  .code-block :focus-visible {
    outline-color: var(--code-on-surface);
  }

  .code-block__code {
    padding: var(--space-4) var(--space-4) var(--space-6);
  }

  .code-block__code :global(pre) {
    margin: 0;
    background: transparent !important;
    color: var(--code-on-surface);
  }
</style>

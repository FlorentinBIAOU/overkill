---
/**
 * Les deux langages d'un barreau, en onglets, dans un bloc d'éditeur.
 *
 * Les deux panneaux sont rendus intégralement dans le HTML. Le JavaScript ne
 * fait que basculer leur visibilité : sans lui, les deux blocs restent
 * lisibles l'un sous l'autre (CDC 8.7, « le site reste lisible sans
 * JavaScript »).
 *
 * La bande d'onglets est sombre et se lit comme celle d'un éditeur : l'onglet
 * actif prend la couleur du fond du code, sous lequel il est posé.
 */
import CodeBlock from './CodeBlock.astro';
import { readSnippet, type Language } from '../lib/snippets';
import type { Strings } from '../i18n';

export interface Props {
  /** Chemins relatifs à `content/`, tels qu'ils figurent dans le frontmatter. */
  paths: Partial<Record<Language, string>>;
  /** Niveau de preuve d'exécution réellement atteint. */
  verification: 'executed' | 'stubbed';
  strings: Strings;
  /** Identifiant unique dans la page, pour lier onglets et panneaux. */
  id: string;
  /** Profondeur du titre masqué de chaque panneau. */
  headingLevel?: 3 | 4 | 5;
}

const { paths, verification, strings, id, headingLevel = 4 } = Astro.props;
const PanelHeading = `h${headingLevel}` as 'h3' | 'h4' | 'h5';

const languages = (['python', 'javascript'] as const).filter((l) => paths[l]);
const snippets = languages.map((l) => readSnippet(paths[l]!, l));

/* La preuve d'exécution descend dans la barre du bloc, au plus près du code
   qu'elle qualifie (partie 1.4 du lot). */
const proof = {
  short: strings.code.proof[verification].short,
  title: strings.code.proof[verification].full,
};
---

<div class="code-tabs" id={id} data-code-tabs>
  <div class="code-tabs__strip" role="tablist" aria-label={strings.code.tabsLabel}>
    {
      snippets.map((s, i) => (
        <button
          type="button"
          role="tab"
          id={`${id}-tab-${s.language}`}
          aria-controls={`${id}-panel-${s.language}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          class="code-tabs__tab"
        >
          {strings.code[s.language]}
        </button>
      ))
    }
  </div>

  {
    snippets.map((s, i) => (
      <div
        role="tabpanel"
        id={`${id}-panel-${s.language}`}
        aria-labelledby={`${id}-tab-${s.language}`}
        class="code-tabs__panel"
        data-first={i === 0 ? 'true' : 'false'}
      >
        <PanelHeading class="visually-hidden">{strings.code[s.language]}</PanelHeading>
        <CodeBlock
          code={s.code}
          language={s.language}
          path={s.path}
          proof={proof}
          copyLabel={strings.code.copy}
          copiedLabel={strings.code.copied}
          failedLabel={strings.code.copyFailed}
        />
      </div>
    ))
  }
</div>

<style>
  .code-tabs__strip {
    display: flex;
    gap: 2px;
    background: var(--code-surface-2);
    border-start-start-radius: var(--radius-block);
    border-start-end-radius: var(--radius-block);
    padding: 4px 4px 0;
  }

  .code-tabs__tab {
    font: inherit;
    font-family: var(--font-code);
    font-size: 0.78rem;
    line-height: 1.3;
    padding: 9px 16px;
    min-height: 36px;
    border: 0;
    border-start-start-radius: var(--radius-block);
    border-start-end-radius: var(--radius-block);
    background: transparent;
    color: var(--code-on-surface-muted);
    cursor: pointer;
  }

  /* L'onglet actif prend la couleur du fond du code : il désigne le bloc
     qu'il ouvre, au lieu de se contenter d'être plus foncé. */
  .code-tabs__tab[aria-selected='true'] {
    background: var(--code-surface);
    color: var(--code-on-surface);
  }

  .code-tabs__tab:focus-visible {
    outline-color: var(--code-on-surface);
    outline-offset: -3px;
  }

  /* Le bloc est posé sous la bande : ses coins hauts s'effacent. */
  .code-tabs__panel :global(.code-block) {
    border-start-start-radius: 0;
    border-start-end-radius: 0;
  }

  .code-tabs__panel + .code-tabs__panel {
    margin-block-start: var(--space-3);
  }

  /* Sans JavaScript, les deux panneaux restent visibles l'un sous l'autre.
     Le module d'onglets pose l'attribut qui masque le panneau inactif. */
  [data-code-tabs][data-enhanced='true'] .code-tabs__panel[hidden] {
    display: none;
  }

  [data-code-tabs]:not([data-enhanced='true']) .code-tabs__strip {
    display: none;
  }

  /* Sans les onglets, chaque bloc retrouve ses quatre coins. */
  [data-code-tabs]:not([data-enhanced='true']) .code-tabs__panel :global(.code-block) {
    border-radius: var(--radius-block);
  }
</style>

---
/**
 * En-tête commun. Logo, navigation principale, sélecteur de langue, bascule de
 * thème.
 *
 * Le sélecteur de langue est un lien vers la même page dans l'autre langue,
 * pas un menu : il fonctionne sans JavaScript et conserve la page courante
 * (CDC 9.3).
 */
import { otherLocale, LOCALE_NAMES, type Locale, type Strings } from '../i18n';
import { route, switchLocale } from '../i18n/routes';

export interface Props {
  lang: Locale;
  strings: Strings;
  /** Chemin courant, pour le lien vers l'autre langue et l'état actif. */
  path: string;
}

const { lang, strings, path } = Astro.props;
const autre = otherLocale(lang);

/* Cinq entrées depuis le lot 14 : le questionnaire s'adresse à qui connaît sa
   finalité mais pas la solution, et il n'existait nulle part. */
const liens = [
  ['catalogue', strings.nav.catalogue],
  ['guide', strings.nav.guide],
  ['methodology', strings.nav.methodology],
  ['contribute', strings.nav.contribute],
  ['about', strings.nav.about],
] as const;
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="site-header__brand" href={route(lang, 'home')}>
      <span class="site-header__mark" aria-hidden="true"></span>
      <span class="site-header__name">{strings.site.name}</span>
    </a>

    <nav class="site-header__nav" aria-label={strings.nav.main}>
      <ul>
        {
          liens.map(([cle, libelle]) => {
            const href = route(lang, cle);
            const actif = path === href || path.startsWith(`${href}/`);
            return (
              <li>
                <a href={href} aria-current={actif ? 'page' : undefined}>
                  {libelle}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="site-header__tools">
      <a
        class="site-header__lang"
        href={switchLocale(path, autre)}
        hreflang={autre}
        lang={autre}
        rel="alternate"
        data-lang-choice={autre}
      >
        <span class="visually-hidden">{strings.nav.language} : </span>
        {LOCALE_NAMES[autre]}
      </a>

      <button type="button" class="site-header__theme" data-theme-toggle>
        <span class="visually-hidden">{strings.nav.theme}</span>
        <span aria-hidden="true">◐</span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    border-block-end: 1px solid var(--rule);
    background: var(--paper);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-6);
    padding-block: var(--space-3);
  }

  /* Les cibles tactiles du site ne descendent pas sous 44 px (CDC 8.7). Ici
     c'est du remplissage vertical plutôt qu'une hauteur minimale : l'alignement
     du carré de marque sur la ligne de base doit survivre. */
  .site-header__brand {
    display: inline-flex;
    align-items: baseline;
    padding-block: 4px;
    gap: var(--space-2);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.375rem;
    letter-spacing: -0.02em;
  }

  /* Le jaune sert en aplat, jamais en couleur de glyphe : son contraste sur
     le blanc est insuffisant (CDC 8.3). Ce repère est donc un carré plein. */
  .site-header__mark {
    display: inline-block;
    width: 0.62em;
    height: 0.62em;
    background: var(--brand);
    border: 1px solid var(--brand-deep);
  }

  .site-header__nav {
    flex: 1 1 auto;
  }

  /* Pas d'interligne entre deux rangées de liens : chaque lien fait déjà
     44 px de haut, la rangée suivante se pose contre lui. À 360 px les cinq
     entrées tiennent ainsi sur deux rangées au lieu de trois. */
  .site-header__nav ul {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-3);
    row-gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--size-small);
  }

  .site-header__nav li {
    max-width: none;
  }

  /* min-width autant que min-height : « À propos » ne fait que 39 px de
     large, et une cible se mesure dans les deux sens. Le libellé reste
     centré, le décalage ne se voit pas. */
  .site-header__nav a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    text-decoration: none;
    color: var(--muted);
  }

  .site-header__nav a:hover,
  .site-header__nav a[aria-current='page'] {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.35em;
    text-decoration-thickness: 2px;
  }

  .site-header__tools {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-inline-start: auto;
  }

  .site-header__lang {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--size-small);
    text-decoration: none;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-pill);
    padding: var(--space-1) var(--space-3);
  }

  .site-header__lang:hover {
    border-color: var(--ink);
  }

  .site-header__theme {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    font: inherit;
    line-height: 1;
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }

  .site-header__theme:hover {
    border-color: var(--ink);
  }

  /*
   * Deux rangées jusqu'à 900 px, une seule au-delà.
   *
   * Marque, navigation et outils ne tiennent sur une ligne qu'à partir de
   * 900 px environ — cinq entrées font 500 px à elles seules. En dessous, la
   * navigation passe sous la ligne de tête et les outils restent avec la
   * marque : deux rangées au lieu de trois, et le contenu remonte de 60 px
   * sur un écran de téléphone. Sans ce point de rupture, l'en-tête était plus
   * haut à 600 px qu'à 360.
   */
  .site-header__tools {
    order: 1;
  }

  .site-header__nav {
    order: 2;
    flex-basis: 100%;
  }

  @media (min-width: 900px) {
    .site-header__tools,
    .site-header__nav {
      order: 0;
      flex-basis: auto;
    }
  }
</style>

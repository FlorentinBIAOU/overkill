---
/**
 * Les trois portes de l'accueil (lot 14, partie 4).
 *
 * Un visiteur qui découvre doit trouver la porte qui lui correspond en moins
 * de dix secondes. Elles sont donc nommées par ce que la personne sait déjà,
 * et non par ce que le site propose : « je ne sais pas quoi employer »,
 * « je cherche une tâche précise », « je veux comprendre l'échelle ».
 *
 * Le chiffre du catalogue est compté, jamais écrit à la main : c'est
 * l'argument le plus vérifiable de la page, et il doit rester vrai à la fiche
 * suivante.
 */
import { type Locale, type Strings } from '../../i18n';
import { route } from '../../i18n/routes';

export interface Props {
  lang: Locale;
  strings: Strings;
  /** Les fiches publiées, pour compter. */
  entries: any[];
}

const { lang, strings, entries } = Astro.props;

const total = entries.length;
/** Celles qui se règlent sans aucune IA : le verdict est N0. */
const sansIA = entries.filter((e) => e.verdict === 'N0').length;

const textes = {
  fr: {
    heading: 'Trois façons d’entrer',
    doors: [
      {
        kicker: 'Vous ne savez pas quoi employer',
        title: 'Répondez à huit questions',
        body: 'Vous connaissez votre besoin, pas la solution. Le questionnaire vous dit ce qui suffit, pourquoi, et vers quelle fiche aller. Deux minutes, aucune connaissance technique.',
        action: 'Par où commencer',
        page: 'guide' as const,
      },
      {
        kicker: 'Vous cherchez une tâche précise',
        title: `${total} fiches, dont ${sansIA} sans aucune IA`,
        body: 'Chaque fiche montre les options de la plus légère à la plus lourde, avec le code qui tourne, ce qu’il coûte, et ce qui le fait céder.',
        action: 'Ouvrir le catalogue',
        page: 'catalogue' as const,
      },
      {
        kicker: 'Vous voulez comprendre l’échelle',
        title: 'Quatre niveaux, une condition pour monter',
        body: 'De la règle au modèle généraliste. Ce que chaque niveau garantit, ce qu’il coûte, et la condition précise qui rend le niveau du dessous insuffisant.',
        action: 'Comment ça marche',
        page: 'methodology' as const,
      },
    ],
  },
  en: {
    heading: 'Three ways in',
    doors: [
      {
        kicker: 'You don’t know what to use',
        title: 'Answer eight questions',
        body: 'You know your need, not the solution. The questionnaire tells you what is enough, why, and which entry to read. Two minutes, no technical knowledge.',
        action: 'Where to start',
        page: 'guide' as const,
      },
      {
        kicker: 'You are after a specific task',
        title: `${total} entries, ${sansIA} of them with no AI at all`,
        body: 'Every entry shows the options from lightest to heaviest, with code that runs, what it costs, and what makes it give way.',
        action: 'Open the catalogue',
        page: 'catalogue' as const,
      },
      {
        kicker: 'You want to understand the scale',
        title: 'Four levels, one condition to climb',
        body: 'From a rule to a general-purpose model. What each level guarantees, what it costs, and the precise condition that makes the level below insufficient.',
        action: 'How it works',
        page: 'methodology' as const,
      },
    ],
  },
}[lang];
---

<section class="doors" aria-labelledby="doors-title">
  <div class="wrap">
    <h2 id="doors-title" class="visually-hidden">{textes.heading}</h2>
    <ul class="doors__list">
      {
        textes.doors.map((porte) => (
          <li class="door">
            <p class="door__kicker">{porte.kicker}</p>
            <h3 class="door__title">{porte.title}</h3>
            <p class="door__body">{porte.body}</p>
            <p class="door__action">
              <a class="button" href={route(lang, porte.page)}>{porte.action}</a>
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .doors {
    padding-block: var(--space-16);
  }

  .doors__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(19rem, 100%), 1fr));
  }

  .door {
    display: flex;
    flex-direction: column;
    max-width: none;
    padding: var(--space-8);
    border: 1px solid var(--rule-strong);
    border-radius: 14px;
  }

  .door__kicker {
    margin: 0;
    font-size: 0.83rem;
    font-weight: 600;
    color: var(--muted);
  }

  .door__title {
    margin: var(--space-3) 0 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.5rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .door__body {
    margin: var(--space-4) 0 var(--space-8);
    font-size: 0.97rem;
    line-height: 1.55;
  }

  .door__action {
    margin: auto 0 0;
  }
</style>

---
/**
 * Affiche une illustration de famille.
 *
 * Les SVG vivent dans `src/assets/illustrations/`. Ils portent un `<title>`
 * neutre ; le titre localisé est posé ici, par la page, à partir des chaînes
 * d'interface. Un SVG ne peut pas porter deux `<title>`, et dupliquer le
 * fichier par langue coûterait le double du budget d'image pour un mot de
 * différence.
 *
 * **L'illustration est masquée aux technologies d'assistance.** Aux trois
 * endroits où elle paraît — la grille de l'accueil, l'index des familles,
 * l'en-tête d'une famille — le nom de la famille est écrit juste à côté, et
 * sur l'accueil il est même dans le même lien. Annoncée, l'illustration
 * faisait bégayer ce lien : « Détecter et filtrer, image, Détecter et
 * filtrer, comment repérer… ». Le `<title>` reste dans le fichier, pour
 * l'ouvrir seul et pour le contrôle des illustrations ; il n'est simplement
 * plus annoncé deux fois.
 *
 * Tant qu'une illustration n'existe pas, un cadre neutre tient sa place et le
 * dit. On ne met pas de fausse image.
 */
import { readFileSync, existsSync } from 'node:fs';
import { resolve } from 'node:path';

export interface Props {
  id: string;
  lang: 'en' | 'fr';
  /** Texte alternatif : le nom de la famille suffit. */
  title: string;
}

const { id, title } = Astro.props;

const chemin = resolve(process.cwd(), 'src/assets/illustrations', `${id}.svg`);
const svg = existsSync(chemin) ? readFileSync(chemin, 'utf8') : null;

/** On remplace le titre neutre du fichier par le titre localisé. */
const rendu = svg
  ? svg
      .replace(/<title>[\s\S]*?<\/title>/, `<title>${title}</title>`)
      .replace(/<svg\b/, '<svg aria-hidden="true" focusable="false"')
      .replace(/\srole="img"/, '')
  : null;
---

{
  rendu ? (
    <div class="family-illustration" set:html={rendu} />
  ) : (
    <div class="family-illustration family-illustration--missing" aria-hidden="true">
      <span>{id}</span>
    </div>
  )
}

<style>
  .family-illustration :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .family-illustration--missing {
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border: 2px dashed var(--rule-strong);
    border-radius: var(--radius-block);
    color: var(--muted);
    font-family: var(--font-code);
    font-size: var(--size-small);
    text-align: center;
    padding: var(--space-4);
  }
</style>

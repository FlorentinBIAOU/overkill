---
/**
 * État vide du catalogue (CDC 7.3) : utile, pas décoratif. Il propose de
 * contribuer la fiche manquante, avec une issue GitHub pré-remplie.
 */
import type { Strings } from '../i18n';

export interface Props {
  strings: Strings;
  issueUrl: string;
}

const { strings, issueUrl } = Astro.props;
---

<div class="empty" data-empty-state hidden>
  <p class="empty__title">{strings.catalogue.empty}</p>
  <p class="empty__help">{strings.catalogue.emptyHelp}</p>
  <p>
    <a class="empty__action" href={issueUrl} rel="noopener" data-empty-action>
      {strings.catalogue.emptyAction}
    </a>
  </p>
</div>

<style>
  .empty {
    padding: var(--space-16) var(--space-6);
    text-align: center;
    background: var(--paper-2);
    border-radius: var(--radius-block);
  }

  .empty p {
    margin-inline: auto;
  }

  .empty__title {
    font-family: var(--font-display);
    font-size: var(--size-h2);
    font-weight: 700;
    margin-block: 0 var(--space-3);
  }

  .empty__help {
    color: var(--muted);
    margin-block-end: var(--space-6);
  }

  .empty__action {
    display: inline-block;
    padding: var(--space-3) var(--space-6);
    background: var(--ink);
    color: var(--paper);
    border-radius: var(--radius-pill);
    text-decoration: none;
    font-weight: 600;
  }
</style>

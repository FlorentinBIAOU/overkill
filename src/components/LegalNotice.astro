---
/**
 * L'encadré permanent de pied de page réglementaire (CDC 4.5).
 *
 * « Information générale, pas un avis juridique, faites valider par un
 * professionnel. » Présent sur toute page portant du contenu réglementaire.
 * Aucune fiche ne dit à quiconque qu'il est conforme ou non.
 */
import type { Strings } from '../i18n';

export interface Props {
  strings: Strings;
}

const { strings } = Astro.props;
---

{/* `role="note"` et non `<aside>` : cet encadré est une remarque, pas une
    région de navigation. Deux repères complémentaires sans nom sur la même
    page — celui-ci et l'appel à l'action — et le lecteur d'écran annonce deux
    fois « complémentaire » sans rien dire de plus. */}
<div class="legal-notice" role="note">
  <p>{strings.legal.notice}</p>
</div>

<style>
  .legal-notice {
    border-block-start: 1px solid var(--rule-strong);
    padding-block-start: var(--space-3);
    font-size: var(--size-small);
    color: var(--muted);
  }

  .legal-notice p {
    margin: 0;
  }
</style>

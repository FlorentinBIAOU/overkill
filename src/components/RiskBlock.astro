---
/**
 * Le bloc risques, en langage clair (lot 14, partie 1.3).
 *
 * Les six champs du CDC 4.2 sont tous là, mais ils ne se lisent plus comme un
 * formulaire : « Sortie de données : rien ne sort » devient « Vos données ne
 * sortent pas ». Une phrase qui se comprend seule, sans légende, et qui ne
 * perd personne — ni celui qui code, ni celui qui décide.
 *
 * Le traitement visuel les distingue d'un paragraphe : cinq constats posés en
 * grille, chacun avec son repère, aucun n'étant une phrase de texte courant.
 *
 * Le périmètre réglementaire garde sa forme de liste : il est factuel et daté,
 * sans conseil (CDC 4.5, interdit 3). L'encadré qui rappelle que ce n'est pas
 * un avis juridique est posé une fois par page, pas à chaque niveau.
 */
import type { Strings } from '../i18n';

export interface Props {
  risks: {
    data_egress: 'none' | 'own-infra' | 'third-party';
    deterministic: boolean;
    testability: 'unit' | 'statistical' | 'hard';
    vendor_lock: 'none' | 'library' | 'provider';
    footprint: 'negligible' | 'low' | 'moderate' | 'high';
    regulatory: { fr: string[]; en: string[] };
  };
  lang: 'en' | 'fr';
  strings: Strings;
  /**
   * Profondeur du titre dans la page. Un composant ne présume pas de l'endroit
   * où on l'emploie : c'est la page qui sait si elle en est au h3 ou au h4.
   */
  headingLevel?: 3 | 4 | 5;
}

const { risks, lang, strings, headingLevel = 4 } = Astro.props;
const Heading = `h${headingLevel}` as 'h3' | 'h4' | 'h5';
const plain = strings.riskPlain;

/**
 * Les cinq constats, dans l'ordre du CDC. `notable` marque celui qui mérite
 * qu'on s'y arrête : il est souligné, jamais coloré, puisque la couleur
 * n'exprime pas de jugement sur ce site (CDC 8.3).
 */
const statements = [
  [plain.data_egress[risks.data_egress], risks.data_egress !== 'none'],
  [plain.deterministic[String(risks.deterministic) as 'true' | 'false'], !risks.deterministic],
  [plain.testability[risks.testability], risks.testability === 'hard'],
  [plain.vendor_lock[risks.vendor_lock], risks.vendor_lock === 'provider'],
  [plain.footprint[risks.footprint], risks.footprint === 'high'],
] as const;

const regulatory = risks.regulatory[lang];
---

<div class="risks">
  <Heading class="risks__heading">{plain.heading}</Heading>

  <ul class="risks__list">
    {
      statements.map(([text, notable]) => (
        <li class:list={['risks__item', notable && 'risks__item--notable']}>
          <span class="risks__mark" aria-hidden="true"></span>
          <span>{text}</span>
        </li>
      ))
    }
  </ul>

  {
    regulatory.length > 0 && (
      <div class="risks__regulatory">
        <p class="risks__regulatory-label">{plain.regulatory}</p>
        <ul>
          {regulatory.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    )
  }
</div>

<style>
  .risks {
    background: var(--paper-2);
    border-radius: 14px;
    padding: var(--space-6);
  }

  .risks__heading {
    margin: 0 0 var(--space-4);
    font-family: var(--font-text);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--muted);
  }

  .risks__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3) var(--space-6);
  }

  @media (min-width: 600px) {
    .risks__list {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Un constat n'est pas une phrase de texte courant : son repère et sa
     graisse le sortent du paragraphe. */
  .risks__item {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    max-width: none;
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.45;
  }

  .risks__mark {
    flex: none;
    width: 7px;
    height: 7px;
    margin-block-start: 0.5em;
    border-radius: 2px;
    background: var(--ink);
  }

  /* Ce qui mérite l'attention est souligné, pas coloré (CDC 8.3). */
  .risks__item--notable > span:last-child {
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 0.25em;
  }

  .risks__item--notable .risks__mark {
    background: transparent;
    border: 1.5px solid var(--ink);
  }

  .risks__regulatory {
    margin-block-start: var(--space-5);
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--rule);
  }

  .risks__regulatory-label {
    margin: 0 0 var(--space-2);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--muted);
    max-width: none;
  }

  .risks__regulatory ul {
    margin: 0;
    padding-inline-start: var(--space-4);
    font-size: 0.9rem;
  }

  .risks__regulatory li {
    max-width: none;
    line-height: 1.5;
  }

  .risks__regulatory li + li {
    margin-block-start: var(--space-1);
  }
</style>

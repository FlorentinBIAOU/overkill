{
  "name": "overkill",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Le bon outil pour la bonne tache. Catalogue d'alternatives frugales a l'IA generative.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/strip-dev-pages.mjs",
    "build:dev": "OVERKILL_DEV_PAGES=1 astro build",
    "preview": "astro preview",
    "fonts": "bash scripts/build-fonts.sh",
    "check:fonts": "node scripts/check-fonts.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:colour": "node scripts/check-colour-usage.mjs",
    "check": "npm run check:fonts && npm run check:contrast && npm run check:colour && npm run check:french && npm run test:schema && npm run check:content && npm run build",
    "check:french": "bash scripts/check-french.sh",
    "fix:accents": ".venv-tools/bin/python scripts/fix-accents.py",
    "check:content": "node --import tsx scripts/check-content.mjs",
    "test:schema": "node --import tsx --test tests/schema.test.mjs tests/check-content.test.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.14",
    "@astrojs/sitemap": "^3.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^5.18.2",
    "tailwindcss": "^4.3.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "gray-matter": "^4.0.3",
    "playwright": "^1.63.0",
    "tsx": "^4.23.13",
    "yaml": "^2.9.0"
  }
}
